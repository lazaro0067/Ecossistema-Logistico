# Cole em Streamlit Cloud › seu app › ⋮ › Settings › Secrets
# (ou copie para .streamlit/secrets.toml no PC). NUNCA envie o secrets.toml de verdade ao GitHub.

# Banco na nuvem (Supabase › Connect › Session pooler)
DATABASE_URL = "postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# E-mail do administrador Master (é o login dele)
ADMIN_EMAIL = "seu.email@grupolima.com.br"

# Envio de e-mail (redefinição de senha e boas-vindas). Gmail: use uma "senha de app".
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USUARIO = "sistema.grupolima@gmail.com"
SMTP_SENHA = "abcd efgh ijkl mnop"
SMTP_REMETENTE = "Ecossistema Logístico <sistema.grupolima@gmail.com>"
